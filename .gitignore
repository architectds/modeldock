node_modules/
.env
coverage/
*.log
.modeldock-media/
.modeldock/
# Generated shortcut (machine-local, absolute path)
ModelDock.lnk

# Stray empty file produced by a PowerShell redirection typo
$null
# Dashboard screenshots (generated, not source)
test/dashboard*.png

# Local scratch files: ad-hoc scripts and probe/tool output that land in the repo root
# during debugging (probe-tmp.png, test-tts.webm, _make_pptx.py, ...)
_*.py
probe-*.png
*.webm

# Full-traffic request dumps (MODELDOCK_DUMP_DIR) contain real user conversation
# content - never tracked, never shared.
modeldock-dumps/
request-*.json
# Browser-automation (CDP) temp user-data profiles left in the repo root
_cdp_*/

# Local long-horizon task test area (rendered pages, screenshots, its own static server)
voxel/

# Release build output
dist/

# Internal docs: kept locally, NEVER published. These carry private strategy and
# business-model decisions. Do not remove these entries; scripts/check-internal-docs.mjs
# fails `pretest` if any of them ever gets tracked.
AGENTS.md
architecture.md


# Local scratch: sandbox scripts, icon drafts, ad-hoc probes
tmp/
# Session diagnostics scratch (probe scripts + dashboard screenshots)
.diag/
# Throwaway CODEX_HOME used when pointing a local Codex at this checkout
.modeldock-codex-home/
# Ad-hoc dashboard screenshot dropped at the root by `npm run shot`
dashboard-shot.png
# llama.cpp run output; the *.log rule only covers log-named files inside it
llama-logs/
# Ad-hoc debugging scripts written next to the real ones during a session
# (scripts/tmp-grep.ps1, tmp-gpu.ps1, ...). The tmp/ rule above does not cover
# them because they sit beside the scripts they were poking at.
scripts/tmp-*
tmp-check*.mjs
